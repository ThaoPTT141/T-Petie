# =================================================================
# T'PETIE — ENVIRONMENT CONFIGURATION (.env)
# =================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# Kết nối Connection Pooler (Transaction pooler) cho ứng dụng chạy runtime:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Kết nối Direct connection dùng cho Prisma migrations (bắt buộc khi dùng Supabase Connection Pooling):
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 2. NEXTAUTH CONFIGURATION
NEXTAUTH_URL="http://localhost:3000"
# Khóa bí mật ký JWT Session (Tạo bằng lệnh: openssl rand -base64 32):
NEXTAUTH_SECRET="tpetie_super_secret_jwt_key_2024_for_auth_session_signing"

# 3. GOOGLE OAUTH 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. MARKETING & ANALYTICS
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
NEXT_PUBLIC_GOOGLE_SHEET_API_URL=""
